---
const fotos = [
  { src: '/fotos_infraestrutura/IMG_1787.jpg', alt: 'Interior da clínica WIN SPORTS — 1' },
  { src: '/fotos_infraestrutura/IMG_1788.jpg', alt: 'Interior da clínica WIN SPORTS — 2' },
  { src: '/fotos_infraestrutura/IMG_1790.jpg', alt: 'Interior da clínica WIN SPORTS — 3' },
  { src: '/fotos_infraestrutura/IMG_1791.jpg', alt: 'Interior da clínica WIN SPORTS — 4' },
  { src: '/fotos_infraestrutura/IMG_1792.jpg', alt: 'Interior da clínica WIN SPORTS — 5' },
  { src: '/fotos_infraestrutura/IMG_1793.jpg', alt: 'Interior da clínica WIN SPORTS — 6' },
  { src: '/fotos_infraestrutura/IMG_1794.jpg', alt: 'Interior da clínica WIN SPORTS — 7' },
];
---

<section id="infraestrutura" class="section bg-slate-50" aria-labelledby="infra-title">
  <div class="container mx-auto">
    <header class="reveal max-w-2xl">
      <span class="section-label">Infraestrutura</span>
      <h2 id="infra-title" class="section-title">Conheça nossa clínica</h2>
      <p class="section-subtitle">
        Espaço equipado e pensado para oferecer o melhor ambiente de reabilitação esportiva.
      </p>
    </header>

    <div class="reveal mt-12" style="--reveal-delay: 100ms;">
      <!-- Carrossel -->
      <div class="relative overflow-hidden rounded-2xl shadow-lg" id="infra-carousel">
        <!-- Track -->
        <div
          id="infra-track"
          class="flex"
          style="transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);"
        >
          {fotos.map((foto) => (
            <div class="shrink-0 basis-full h-[420px] md:h-[520px]">
              <img
                src={foto.src}
                alt={foto.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>

        <!-- Botão anterior -->
        <button
          id="infra-prev"
          aria-label="Foto anterior"
          class="absolute left-3 top-1/2 -translate-y-1/2 hidden md:grid h-11 w-11 place-items-center rounded-full bg-navy/70 text-white shadow-md backdrop-blur-sm transition hover:bg-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-400"
        >
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <!-- Botão próximo -->
        <button
          id="infra-next"
          aria-label="Próxima foto"
          class="absolute right-3 top-1/2 -translate-y-1/2 hidden md:grid h-11 w-11 place-items-center rounded-full bg-navy/70 text-white shadow-md backdrop-blur-sm transition hover:bg-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-400"
        >
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>

      <!-- Dots -->
      <div
        id="infra-dots"
        class="mt-5 flex justify-center gap-2"
        role="tablist"
        aria-label="Navegação do carrossel de fotos"
      >
        {fotos.map((_, i) => (
          <button
            role="tab"
            aria-label={`Foto ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-index={String(i)}
            class:list={[
              'h-2 rounded-full transition-all duration-300',
              i === 0 ? 'w-6 bg-cyan-500' : 'w-2 bg-slate-300',
            ]}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('infra-track') as HTMLElement;
  const dotsContainer = document.getElementById('infra-dots') as HTMLElement;
  const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = ((index % total) + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((dot, i) => {
      const active = i === current;
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
      dot.className = [
        'h-2 rounded-full transition-all duration-300',
        active ? 'w-6 bg-cyan-500' : 'w-2 bg-slate-300',
      ].join(' ');
    });
  }

  document.getElementById('infra-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('infra-next')?.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot) => {
    dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
  });

  // Swipe touch
  const carousel = document.getElementById('infra-carousel') as HTMLElement;
  let touchStartX = 0;
  carousel.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  carousel.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
  }, { passive: true });
</script>
